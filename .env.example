# Local configuration for Telegram Web + the integrated services center.
# Copy this file to .env and fill in the values locally.

PORT=8080
SESSION_SECRET=replace-with-a-long-random-value

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
GROQ_API_KEY=

# Optional GitHub backup used by the legacy services.
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main

# Enable the original Flask services inside the unified React shell.
LEGACY_FLASK_ENABLED=true
LEGACY_FLASK_PORT=5001